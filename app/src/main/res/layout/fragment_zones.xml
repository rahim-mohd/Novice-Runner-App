<?xml version="1.0" encoding="utf-8"?>
<!--
    FRAGMENT_ZONES.XML - Heart Rate Zone Calculator (Zones Tab)
    ===========================================================
    This is the core feature of the app. It allows users to:
    - Enter their age
    - Calculate their maximum heart rate using the Karvonen formula (220 - age)
    - View all five heart rate zones with their respective percentage ranges

    This is the default tab displayed when the app opens.
-->

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Age Input - Centered vertically and horizontally
      User enters their age here to calculate heart rate zones-->
    <EditText
        android:id="@+id/etAge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter your age"
        android:inputType="number"
        android:digits="0123456789"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginHorizontal="32dp"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Calculate Button
    Triggers the heart rate zone calculation-->
    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CALCULATE ZONES"
        android:textSize="16sp"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/etAge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Max HR Result
    Displays the calculated Maximum Heart Rate
    Format: "Max HR: 190 bpm" -->
    <TextView
        android:id="@+id/tvMaxHr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Max HR: --"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#2196F3"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/btnCalculate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Zones Result
    Displays all five heart rate zones with their ranges
    Format:          Zone 1 (50-60%): 95.00 - 114.00, Zone 2 ((60-70%): 114.00 - 133.00
         ... etc-->
    <TextView
        android:id="@+id/tvZones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zones will appear here"
        android:textSize="15sp"
        android:textColor="#444444"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvMaxHr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>